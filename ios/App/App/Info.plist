<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Thalassa needs your location to provide local marine weather forecasts and navigation.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Thalassa needs your location to provide local marine weather forecasts and navigation.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Thalassa needs continuous location access to automatically log your position every 15 minutes while on a voyage, even when the app is in the background.</string>
	<key>NSMotionUsageDescription</key>
	<string>Thalassa uses motion detection to optimize GPS battery usage by detecting when you are stationary at anchor versus underway.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Thalassa uses the microphone for voice-to-text dictation in the Captain's Journal and for the Bosun voice console, allowing you to talk to the boat's AI first mate hands-free.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Thalassa uses speech recognition to transcribe your spoken diary entries and Bosun questions, letting you capture your passage and ask the boat about weather, systems, and live state without typing.</string>
	<key>NSCameraUsageDescription</key>
	<string>Thalassa uses the camera to scan barcodes on inventory items and spare parts for quick identification and stock management.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Thalassa uses Apple Music to let Calypso, your AI first mate, search and play music, show your playlists, and—only when you ask—create playlists or add tracks to them. Thalassa never deletes or changes your music without your request.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
		<string>processing</string>
		<string>audio</string>
	</array>
	<!-- Bad Elf MFi protocol declaration (Shane 2026-08-02: "add the plist
	     key, chance the app review"). Without this, EAAccessoryManager's
	     connectedAccessories never lists the receiver, so the app could only
	     see the Bad Elf WHILE it was actively supplying the Core Location fix
	     — never by name, and never while merely paired. App Review may ask
	     for MFi vendor authorization for this string; that risk is accepted. -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.bad-elf.gps</string>
	</array>
