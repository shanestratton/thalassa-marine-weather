<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Thalassa uses your location while the app is open to show local marine weather, your dashboard position, navigation tools, and the anchor position you choose.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Thalassa uses your location in the background only while you explicitly arm Anchor Watch or start voyage logging, so it can detect anchor dragging and record your passage while the screen is locked.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Thalassa uses your location in the background only while you explicitly arm Anchor Watch or start voyage logging, so it can detect anchor dragging and record your passage while the screen is locked.</string>
	<key>NSMotionUsageDescription</key>
	<string>Thalassa reads your iPhone's built-in barometer to show live air pressure and its three-hour trend, and uses motion detection to save GPS battery by telling stationary-at-anchor from underway.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Thalassa uses the microphone for voice-to-text dictation in the Captain's Journal and for the Bosun voice console, allowing you to talk to the boat's AI first mate hands-free.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Thalassa uses speech recognition to transcribe your spoken diary entries and Bosun questions, letting you capture your passage and ask the boat about weather, systems, and live state without typing.</string>
	<key>NSCameraUsageDescription</key>
	<string>Thalassa uses the camera to scan barcodes on inventory items and spare parts for quick identification and stock management.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Thalassa connects to your Apple Music library so you can play your music and playlists from the helm, and so the Bosun voice console can change the tune hands-free while you sail.</string>
	<!-- audio = anchor-alarm tones; location =
	     voyage tracking; fetch = diary outbox drain (BGAppRefreshTask via
	     TSBackgroundFetch — requires the BGTaskSchedulerPermittedIdentifiers
	     below or iOS never registers the task and background fetch silently
	     cannot fire). 'processing' removed 2026-08-02: no BGProcessingTask
	     is ever scheduled (no BackgroundFetch.scheduleTask call anywhere),
	     and an undefended declared mode is App-Review bait. A duplicate
	     'audio' entry was also removed. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.transistorsoft.fetch</string>
	</array>
	<key>TSLocationManagerLicense</key>
	<string>eyJhbGciOiJFZERTQSIsImtpZCI6ImVkMjU1MTktbWFpbi12MSJ9..BXOLcZYe8B3kzNJojLt4i1E_vIYvjAkLtprDNZpQK1N1yCXWwPCnXYNtGq2icZpm6vz0q3M5bl6EyqXZm_IyAg</string>
	<!-- Makes the app's Documents folder browsable in Files under
	     "On My iPhone > Thalassa". The S-63 fingerprint is written there, so a
	     skipper can always find it again from a browser's file picker rather
	     than hunting for wherever the share sheet put it. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Thalassa</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Google OAuth returns to this reversed iOS client ID after consent.
	     Keep this in lock-step with VITE_GOOGLE_OAUTH_CLIENT_ID. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.717700927804-t644h587eb4kaklh3cb495k2ec7q8q6v</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                    <key>UISceneStoryboardFile</key>
                    <string>Main</string>
                </dict>
            </array>
        </dict>
    </dict>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSupportsShakeToEdit</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
    <!-- Local-network HTTP is required for user-owned marine electronics
	     discovered on the boat LAN. Public/WAN cleartext loads, including
	     direct HTTP access to Tailscale/CGNAT addresses, remain blocked by
	     ATS; remote devices must use HTTPS or a local relay. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_signalk-http._tcp</string>
		<string>_signalk-ws._tcp</string>
		<string>_thalassa-cache._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Thalassa uses local network access to discover Signal K servers on your boat's network for nautical chart overlays and instrument data.</string>
</dict>
</plist>
