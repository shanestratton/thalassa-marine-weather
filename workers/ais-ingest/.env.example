# AIS Ingestion Worker — Environment Variables
# Copy to .env and fill in values

# AISStream.io API key (from https://aisstream.io/apikeys)
# Leave empty unless the separately licensed legacy socket is deliberately used.
AISSTREAM_KEY=

# Fleet AISHub provider key. This still makes NO provider requests until the
# service-only ais_fleet_control licence gate is reviewed and enabled.
AISHUB_API_KEY=

# Supabase connection (use SERVICE ROLE key, not anon)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Public-beta hold: absent/false is disabled. Only the exact value "true"
# starts privileged Guardian BOLO/geofence monitoring and notifications.
GUARDIAN_WATCHDOG_ENABLED=false

# Legacy AISStream boxes only; AISHub uses persisted rotating fleet interests.
# Never configure a planet-wide socket as a substitute for the bounded poller.
# BOUNDING_BOXES=[[[50,-1],[51,1]]]

# Batch config
BATCH_FLUSH_MS=2000
BATCH_MAX_SIZE=50
