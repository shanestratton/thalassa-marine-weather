# AIS Ingestion Worker — Environment Variables
# Copy to .env and fill in values

# AISStream.io API key (from https://aisstream.io/apikeys)
AISSTREAM_KEY=your-aisstream-api-key

# Supabase connection (use SERVICE ROLE key, not anon)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Public-beta hold: absent/false is disabled. Only the exact value "true"
# starts privileged Guardian BOLO/geofence monitoring and notifications.
GUARDIAN_WATCHDOG_ENABLED=false

# Bounding boxes: JSON array of [[lat1,lon1],[lat2,lon2]] pairs
# Default: Global coverage (all vessels worldwide)
BOUNDING_BOXES=[[[-90,-180],[90,180]]]

# Batch config
BATCH_FLUSH_MS=2000
BATCH_MAX_SIZE=50
