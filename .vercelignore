# Test and development-only material. e2e/ goes with tests/: its Playwright
# fixtures import from tests/, so with tests/ gone tsc failed every deploy
# with TS2307 on e2e/fixtures (2026-10-10). The app never imports e2e/.
tests/
e2e/
# browser-tests/ goes with them for the same reason: its Playwright helpers
# import from tests/ (browser-tests/helpers/windPixelCapture.ts reads
# tests/helpers/colourScience), so with tests/ gone tsc failed the build 127
# deploy with TS2307 (2026-10-13). The app never imports browser-tests/.
# tests/VercelUploadImports.test.ts fails if an uploaded file imports one of
# these folders again.
browser-tests/
stories/
.storybook/
experiments/
playwright*.config.ts
vitest.config.ts
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
*.test.ts
*.test.tsx
docs/
tools/
# Offline NOAA publisher CLIs use the separately deployed Pi/GDAL converter.
# They are not part of the web runtime or its build dependency graph.
scripts/noaa-enc/
# Disposable SQL proof CLIs import the separately deployed wake Edge contract.
scripts/check-pi-wake-db.mjs
scripts/check-pi-wake-postgres.mjs
icons_new/
bundle-stats.html

# Independently deployed runtimes and native projects
android/
ios/
pi-cache/
cloudflare-worker/
workers/
vessel-scraper/

# supabase/ is excluded EXCEPT functions/_shared, which the browser build
# genuinely needs: services/ww3CacheClient.ts imports its wave types and
# constants from supabase/functions/_shared/ww3. With the whole tree excluded,
# Vercel's checkout was missing that module and tsc failed the build with
# TS2307 "Cannot find module" — while building fine here, where the file
# obviously exists. Every production deploy has failed since 2026-07-24, when
# this ignore file and ww3CacheClient landed on the same day.
#
# Written as `supabase/*` rather than `supabase/`, deliberately: gitignore
# semantics (which this file follows) cannot re-include anything beneath a
# directory that is itself excluded, so the negations below would be silently
# inert. Each level has to be opened before the next can be re-included.
supabase/*
!supabase/functions
supabase/functions/*
!supabase/functions/_shared

# Large local data caches; production map/chart samples live under public/
tiles/
