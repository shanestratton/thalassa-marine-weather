# Thalassa Marine Weather — Environment Variables
# Copy this file to .env and fill in your values

# ── Required ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_your-project-key
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# ── Required release client-visible services ──
VITE_OWM_API_KEY=your-openweathermap-api-key

# Paid provider credentials (Rainbow, Open-Meteo, Spoonacular, WeatherKit,
# voice/AI services, Stripe, etc.) are Supabase/worker secrets. Never prefix
# those values with VITE_: Vite embeds every VITE_ value in the app bundle.

# ── Required release monitoring ──
VITE_SENTRY_DSN=your-sentry-dsn

# ── Auto-set by CI ──
VITE_APP_VERSION=dev

# Gmail is held in the public beta; this must remain empty in production.
# A development-only OAuth identifier may be supplied outside release builds.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Public-beta feature switches, held integrations, and public endpoints are
# owned by config/public-beta-features.json for deterministic production
# builds. Do not duplicate or override that release profile here.
