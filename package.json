{
    "name": "thalassa-marine-weather",
    "private": true,
    "version": "1.2.0",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run check:client-secrets && NODE_OPTIONS=--max-old-space-size=4096 tsc && vite build && npm run check:client-secrets -- --dist",
        "check:bundle": "node scripts/check-bundle-size.js",
        "check:beta": "node scripts/check-beta-readiness.mjs",
        "check:beta:source": "node scripts/check-beta-readiness.mjs --source-only",
        "check:client-secrets": "node scripts/check-client-secrets.mjs",
        "check:web-release": "node scripts/verify-web-release.mjs",
        "preview": "vite preview",
        "cap:sync": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 cap sync",
        "cap:ios": "cap open ios",
        "ship": "npm run build && npm run cap:sync && npm run check:client-secrets -- --artifacts",
        "ship:beta": "npm run check:beta && npm run build && npm run check:web-release && npm run check:bundle && npm run lint:routes && npm run cap:sync && npm run check:client-secrets -- --artifacts && node scripts/check-beta-readiness.mjs --artifacts",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "test:watch": "vitest --watch",
        "test:e2e": "playwright test",
        "lint": "eslint . && npm run lint:migrations",
        "lint:fix": "eslint . --fix",
        "lint:migrations": "node scripts/audit-supabase-migrations.mjs",
        "lint:routes": "node scripts/audit-orphan-routes.mjs --strict",
        "format": "prettier --write '**/*.{ts,tsx,json,md}' --ignore-path .prettierignore --ignore-path .gitignore --ignore-path ios/.gitignore",
        "format:check": "prettier --check '**/*.{ts,tsx,json,md}' --ignore-path .prettierignore --ignore-path .gitignore --ignore-path ios/.gitignore",
        "prepare": "husky",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@capacitor-community/apple-sign-in": "^7.1.0",
        "@capacitor-community/keep-awake": "^8.0.0",
        "@capacitor-community/speech-recognition": "^7.0.1",
        "@capacitor/app": "^8.0.0",
        "@capacitor/browser": "^8.0.2",
        "@capacitor/core": "^8.0.2",
        "@capacitor/filesystem": "^8.1.0",
        "@capacitor/geolocation": "^8.0.0",
        "@capacitor/haptics": "^8.0.0",
        "@capacitor/keyboard": "^8.0.0",
        "@capacitor/local-notifications": "^8.0.2",
        "@capacitor/network": "^8.0.1",
        "@capacitor/preferences": "^8.0.0",
        "@capacitor/push-notifications": "^8.0.0",
        "@capacitor/screen-orientation": "^8.0.0",
        "@capacitor/share": "^8.0.0",
        "@capacitor/status-bar": "^8.0.0",
        "@dnd-kit/core": "^6.1.0",
        "@dnd-kit/sortable": "^8.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@mapbox/vector-tile": "^2.0.4",
        "@sentry/react": "^10.44.0",
        "@supabase/supabase-js": "^2.39.0",
        "@transistorsoft/capacitor-background-fetch": "^8.1.3",
        "@transistorsoft/capacitor-background-geolocation": "^9.3.0",
        "@turf/along": "^7.3.4",
        "@turf/bearing": "^7.3.4",
        "@turf/boolean-point-in-polygon": "^7.3.4",
        "@turf/helpers": "^7.3.4",
        "@turf/length": "^7.3.4",
        "@turf/line-intersect": "^7.3.5",
        "@turf/point-to-line-distance": "^7.3.5",
        "capacitor-tcp-socket": "^7.1.0",
        "delaunator": "^5.1.0",
        "framer-motion": "^12.38.0",
        "jspdf": "^4.1.0",
        "leaflet": "^1.9.4",
        "leaflet-velocity-ts": "^1.2.0",
        "leaflet.markercluster": "^1.5.3",
        "leaflet.offline": "^3.2.1",
        "mapbox-gl": "^3.18.1",
        "martinez-polygon-clipping": "^0.8.1",
        "pbf": "^4.0.1",
        "rbush": "^4.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-map-gl": "^8.1.1",
        "sql.js": "^1.14.1",
        "suncalc": "^1.9.0",
        "tz-lookup": "^6.1.25",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.0.2",
        "@capacitor/ios": "^8.0.2",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.41.2",
        "@storybook/react-vite": "^10.5.3",
        "@supabase/auth-js": "^2.98.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^14.3.1",
        "@transistorsoft/background-geolocation-types": "^5.2.2",
        "@types/geojson": "^7946.0.16",
        "@types/leaflet": "^1.9.21",
        "@types/mapbox-gl": "^3.4.1",
        "@types/node": "^20.12.7",
        "@types/rbush": "^4.0.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@types/sql.js": "^1.4.11",
        "@types/suncalc": "^1.9.2",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/coverage-v8": "4.1.10",
        "@vitest/ui": "4.1.10",
        "autoprefixer": "^10.4.17",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.0.1",
        "husky": "^9.1.7",
        "jsdom": "^24.1.3",
        "lighthouse": "^13.4.1",
        "lint-staged": "^16.4.0",
        "patch-package": "^8.0.1",
        "postcss": "^8.5.25",
        "prettier": "^3.8.1",
        "proxy-agent": "^8.0.2",
        "puppeteer": "^25.4.0",
        "rollup-plugin-visualizer": "^7.0.1",
        "storybook": "^10.5.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.57.0",
        "vite": "^7.3.0",
        "vitest": "4.1.10"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --no-warn-ignored"
        ],
        "*.{ts,tsx,json,md}": [
            "prettier --check"
        ]
    }
}
