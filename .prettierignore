# Generated test baselines — written by REGEN_* scripts as 2-space JSON, never
# hand-edited. Keeping them out of prettier so honest re-pins (e.g.
# REGEN_ARBITRATION_BASELINE=1) stay pre-commit-hook clean. Parsed via
# JSON.parse in tests, so whitespace is irrelevant to correctness.
tests/fixtures/*-baseline.json

# Build output
dist/

# Supabase Edge Functions run on Deno and use `deno fmt` as their canonical
# formatter. Keeping this tree out of Prettier prevents the two formatters from
# rewriting the same TypeScript back and forth.
supabase/functions/

# Generated anchorage data + build cache — data, not code
public/anchorages/qld/
scripts/anchorages/.cache/

# Generated Thalassa Ocean context layer (scripts/ocean/build-context.mjs):
# data, one record per line, rebuilt rather than hand-edited.
public/ocean-data/

# Captured public buoy responses (NDBC, Queensland CKAN, Marine Institute
# ERDDAP), kept byte-for-byte as recorded evidence (build 123, W1-11). The
# readers parse them from raw text, so reformatting would stop them being the
# responses the providers actually sent.
tests/fixtures/buoys/

