# ═══════════════════════════════════════════════
# Thalassa Pi Cache — Configuration
# ═══════════════════════════════════════════════
# Copy to .env and fill in your values.

# Port for the cache server (default: 3001)
# Signal K uses 3000, AvNav uses 8080 — don't conflict.
PORT=3001

# Operator-owned Signal K source. Tokens stay on this Pi, never in app settings.
SIGNALK_ORIGIN=http://127.0.0.1:3000
# SIGNALK_ACCESS_TOKEN=<approved-device-access-token>
# Non-loopback private HTTP requires an explicit choice; HTTPS is preferred.
THALASSA_SIGNALK_ALLOW_HTTP_LAN=0
# Separate route-write permission; read access does not enable course writes.
THALASSA_SIGNALK_COURSE_WRITES=0

# ── Supabase (forwards requests to your Edge Functions) ──
# Get these from your Thalassa Supabase project dashboard.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Cache Settings ──
# Directory for cached data (default: ./cache)
CACHE_DIR=./cache

# How often to pre-fetch weather data (minutes, default: 15)
PREFETCH_INTERVAL=15

# ── Pre-fetch Location (lat,lon for scheduled weather downloads) ──
# Set this to your boat's typical location or cruising ground.
# The Pi will pre-fetch weather for this area on schedule.
PREFETCH_LAT=-36.84
PREFETCH_LON=174.76

# Pre-fetch radius in degrees (covers this area around the point)
PREFETCH_RADIUS=5

# Optional, explicitly selected onboard sensor exports. No automatic bank selection.
# JSON schemas and freshness contracts: src/onboardSensors.ts
# THALASSA_WIND_FILE=/absolute/path/to/wind.json
# THALASSA_HOUSE_BATTERY_FILE=/absolute/path/to/house_battery.json
