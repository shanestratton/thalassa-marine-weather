# Thalassa chart vault (Pi update 3, 127-C-d decision 2).
#
# The one process on the Pi that turns a delivered o-charts .oesu into chart
# data, in its own RAM, on demand. thalassa-cache reaches it over a unix
# socket only. install.sh fills in @USER@ (thalassa-cache's User), @NODE@ (its
# node) and @HOME@ (that user's home) from `systemctl show thalassa-cache`,
# then checks the result with `systemd-analyze verify` before enabling it.
#
# Every limit here is PROVISIONAL: the read-only measurement on calypso
# (M0-M5) sets the final numbers, in pi-cache/src/vault/limits.ts first;
# src/vault/unitFile.test.mts holds this file equal to it. systemd allows no
# trailing comments, so each note sits on its own line above its key.
[Unit]
Description=Thalassa chart vault (o-charts cells decrypted in memory only)
After=local-fs.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
WorkingDirectory=/opt/thalassa-pi-cache
# --max-old-space-size: limits.ts maxOldSpaceMB (M2/M5: largest cell's heap peak x 1.5).
ExecStart=@NODE@ --max-old-space-size=512 dist/vault/main.js
# VAULT_LRU_MB: limits.ts lruMB (M5). TMPDIR is the vault's own tmpfs /tmp
# (PrivateTmp), not thalassa-cache's staging drop-in.
Environment=NODE_ENV=production TMPDIR=/tmp VAULT_LRU_MB=600
Environment=VAULT_SOCKET=/run/thalassa-chart-vault/vault.sock
Environment=ENC_CHART_DIR=/opt/thalassa-pi-cache/enc-charts
Environment=VAULT_STATE_DIR=/opt/thalassa-pi-cache/enc-charts/vault
Environment=VAULT_REFERENCE_DIR=/opt/thalassa-pi-cache/reference
Environment=ENC_WATCH_DIR=@HOME@/Charts
Environment=VAULT_OEXSERVERD=@HOME@/.local/bin/oexserverd
# Nice ranks the vault's own threads only: CPUQuota turns the cgroup cpu
# controller on in system.slice, and each service then gets its CPUWeight.
Nice=10
# A ninth of an ordinary service's share under contention (systemd's default
# is 100), and a thirtieth of thalassa-cache's (300, its drop-in). limits.ts cpuWeight.
CPUWeight=10
# Two of the four cores at most: the watch, Signal K and the rest keep two (M3: 100% if over budget).
CPUQuota=200%
# Ignored by the NVMe's default 'none' scheduler: kept for an SD card or USB disk, relied on nowhere.
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# M5: vault + oexserverd RSS with the LRU full, budget 1.4 GB.
MemoryHigh=1400M
MemoryMax=1700M
# The vault's pages are never swapped, to zram or anywhere (rootchecks.sh: swap accounting present).
MemorySwapMax=0
# The kernel kills the vault first, never the watch.
OOMScoreAdjust=800
# No core dump of chart memory (oexserverd inherits it).
LimitCORE=0
UMask=0077
# oexserverd's FIFOs (/tmp/OCPN_PIPEX and the return pipes) live in the vault's own tmpfs /tmp.
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# The only directory it writes: vault-index.json and removed.json, catalogue only.
ReadWritePaths=/opt/thalassa-pi-cache/enc-charts/vault
RuntimeDirectory=thalassa-chart-vault
RuntimeDirectoryMode=0700
# M1 decides these two: if oexserverd or libsglarm64 opens a netlink socket
# for USB hotplug, this becomes "AF_UNIX AF_NETLINK"; if it opens any other
# network socket, PrivateNetwork goes and the README says why. The SG-Lock
# needs /dev/bus/usb, so PrivateDevices stays off; V8's JIT needs
# MemoryDenyWriteExecute off.
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
KillMode=control-group
Restart=on-failure
RestartSec=30
TasksMax=64

[Install]
WantedBy=multi-user.target
